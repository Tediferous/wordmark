package html

import "github.com/tediferous/wordmark/font"

templ Page(){
  <!doctype html>
  <html>
    <head>
      <title>Title</title>
      <meta name="viewport" content="width=device-width, initial-scale=1.0">
       <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    </head>
    <body class="w-full max-w-full overflow-x-hidden p-2">
      <div class="flex flex-wrap
            p-2 resize 
            overflow-auto rounded border-solid border-2
            max-w-full min-w-0
            h-220 w-100
      ">
        @font.T()
        @font.E()
        @font.D()
        @font.I()
        @font.F()
        @font.E()
        @font.R()
        @font.O()
        @font.U()
        @font.S()
      </div>

      
    </body>
  </html>
}
